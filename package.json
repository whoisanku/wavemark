{
  "name": "wavemark",
  "version": "0.1.0",
  "description": "Tiny zero-dependency avatar library: any string becomes 3–5 wave sources, and the avatar is their interference pattern. Same name, same avatar, forever.",
  "license": "MIT",
  "author": "Ankit Bhandari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoisanku/wavemark.git"
  },
  "homepage": "https://github.com/whoisanku/wavemark#readme",
  "bugs": "https://github.com/whoisanku/wavemark/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/wavemark.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/wavemark.js",
      "default": "./dist/wavemark.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "avatar",
    "identicon",
    "generative-art",
    "wave-interference",
    "canvas",
    "zero-dependency"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:fixtures": "node scripts/fixtures.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
